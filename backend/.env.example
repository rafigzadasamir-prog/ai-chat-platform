# Copy to .env and adjust as needed. All values shown are the defaults.

# SQLAlchemy connection string. Swap to Postgres with no code changes, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_chat_platform
DATABASE_URL=sqlite:///./ai_chat_platform.db

# JWT signing secret -- change this in any real deployment.
SECRET_KEY=dev-secret-key-change-me-in-production-please-32-bytes-min
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Leave unset / empty to use the deterministic, fully offline AI backend.
# Set a real key to use Anthropic's Claude via the official SDK instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# "auto" | "hashing" | "sentence-transformers"
EMBEDDINGS_BACKEND=auto

RATE_LIMIT_MESSAGES_PER_MINUTE=20

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
